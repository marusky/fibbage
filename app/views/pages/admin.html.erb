<%= turbo_stream_from @game %>

<div class="min-h-screen bg-violet-600 bg-[radial-gradient(circle,rgba(255,255,255,0.15)_2px,transparent_2px)] [background-size:28px_28px] px-4 py-10 font-sans">
  <div class="mx-auto w-full max-w-2xl">

    <div class="relative -rotate-1 rounded-2xl border-4 border-black bg-yellow-300 p-8 shadow-[8px_8px_0_0_#000]">
      <span class="absolute -top-5 left-6 inline-block rotate-2 rounded-lg border-4 border-black bg-pink-500 px-4 py-1 text-sm font-black uppercase tracking-widest text-white shadow-[4px_4px_0_0_#000]">
        Admin
      </span>

      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-lg border-4 border-black bg-white px-3 py-1 text-sm font-black uppercase tracking-wide text-black shadow-[3px_3px_0_0_#000]">
          Game: <%= @game.on? ? "running" : "off" %>
        </span>
        <span class="rounded-lg border-4 border-black bg-white px-3 py-1 text-sm font-black uppercase tracking-wide text-black shadow-[3px_3px_0_0_#000]">
          Question #<%= @game.question_number %>
        </span>
        <span class="rounded-lg border-4 border-black bg-cyan-300 px-3 py-1 text-sm font-black uppercase tracking-wide text-black shadow-[3px_3px_0_0_#000]">
          State: <%= @game.current_question.state %>
        </span>
      </div>

      <p class="mt-5 text-2xl font-black leading-snug text-black">
        <%= @game.current_question.question %>
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <%= button_to start_game_path, method: :patch,
          class: "cursor-pointer rounded-xl border-4 border-black bg-lime-400 px-6 py-4 text-xl font-black uppercase tracking-wider text-black shadow-[6px_6px_0_0_#000] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#000] active:translate-x-1 active:translate-y-1 active:shadow-none",
          form_class: "contents" do %>
        Start
      <% end %>

      <%= button_to open_question_path, method: :patch,
          class: "cursor-pointer rounded-xl border-4 border-black bg-yellow-300 px-6 py-4 text-xl font-black uppercase tracking-wider text-black shadow-[6px_6px_0_0_#000] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#000] active:translate-x-1 active:translate-y-1 active:shadow-none",
          form_class: "contents" do %>
        Open answers
      <% end %>

      <%= button_to open_voting_question_path, method: :patch,
          class: "cursor-pointer rounded-xl border-4 border-black bg-orange-300 px-6 py-4 text-xl font-black uppercase tracking-wider text-black shadow-[6px_6px_0_0_#000] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#000] active:translate-x-1 active:translate-y-1 active:shadow-none",
          form_class: "contents" do %>
        Open voting
      <% end %>

      <%= button_to evaluate_question_path, method: :patch,
          class: "cursor-pointer rounded-xl border-4 border-black bg-pink-500 px-6 py-4 text-xl font-black uppercase tracking-wider text-white shadow-[6px_6px_0_0_#000] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#000] active:translate-x-1 active:translate-y-1 active:shadow-none",
          form_class: "contents" do %>
        Evaluate
      <% end %>

      <%= button_to next_question_game_path, method: :patch,
          class: "cursor-pointer rounded-xl border-4 border-black bg-cyan-300 px-6 py-4 text-xl font-black uppercase tracking-wider text-black shadow-[6px_6px_0_0_#000] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_#000] active:translate-x-1 active:translate-y-1 active:shadow-none sm:col-span-2",
          form_class: "contents" do %>
        Next question →
      <% end %>
    </div>

  </div>
</div>
